{
  "name": "reel-inspector",
  "type": "module",
  "private": true,
  "scripts": {
    "wasm": "cd wasm && GOOS=js GOARCH=wasm go build -trimpath -ldflags='-s -w' -o ../public/reel.wasm . && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../public/wasm_exec.js",
    "samples": "rm -rf public/samples && mkdir -p public/samples && REEL_INSPECTOR_SAMPLES=\"$PWD/public/samples\" go -C ../../steep/_examples test -count=1 -run '^TestInspectorSamples$' ./simple/",
    "assets": "bun run wasm && bun run samples",
    "dev": "bun run assets && nuxt dev",
    "build": "bun run assets && nuxt generate",
    "preview": "vite preview --outDir .output/public --base \"${NUXT_APP_BASE_URL:-/}\" --port 3000",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.worker.json",
    "test": "bun test tests/",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.65.0",
    "@tanstack/vue-virtual": "^3.13.50",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "idb-keyval": "^6.3.0",
    "nuxt": "^4.0.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "shadcn-nuxt": "^2.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vue-tsc": "^3.3.14"
  }
}
