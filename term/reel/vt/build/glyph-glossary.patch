+/// Report the Glyph Protocol glossary: out_count gets the number of entries
+/// and out_generation a value that changes whenever they do.
+pub fn glyph_glossary(
+    terminal_: Terminal,
+    out_count: *usize,
+    out_generation: *u64,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const glossary = &wrapper.terminal.glyph_glossary;
+    out_count.* = glossary.entries.count();
+    out_generation.* = glossary.generation;
+    return .success;
+}
+
+/// Report glossary entry index, oldest first: its codepoint and the register
+/// command it came from, which stays valid until the glossary next changes.
+pub fn glyph_glossary_entry(
+    terminal_: Terminal,
+    index: usize,
+    out_cp: *u32,
+    out_raw: *[*]const u8,
+    out_len: *usize,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const entries = &wrapper.terminal.glyph_glossary.entries;
+    if (index >= entries.count()) return .invalid_value;
+    const raw = entries.values()[index].raw;
+    out_cp.* = entries.keys()[index];
+    out_raw.* = raw.ptr;
+    out_len.* = raw.len;
+    return .success;
+}
